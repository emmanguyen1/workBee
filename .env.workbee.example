# No job API keys required. Compose sets database and Redis URLs.
HIVE_CONFIG=hives/careers/hive.yml
KILL_SWITCH=false

# Optional Bee AI. Keep this key server-side; never paste it into chat or commit it.
WORKBEE_GEMINI_API_KEY=
WORKBEE_AI_MODEL=gemini-4-hydrogen

# Optional social sign-in. Register the exact callback URLs from the setup guide.
WORKBEE_PUBLIC_URL=http://localhost:8001
WORKBEE_GOOGLE_CLIENT_ID=
WORKBEE_GOOGLE_CLIENT_SECRET=
WORKBEE_LINKEDIN_CLIENT_ID=
WORKBEE_LINKEDIN_CLIENT_SECRET=
